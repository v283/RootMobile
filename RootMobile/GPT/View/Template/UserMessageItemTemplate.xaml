<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<Grid
    x:Class="RootMobile.Views.Templates.UserMessageItemTemplate"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:model="clr-namespace:RootMobile.Models"
    x:DataType="model:Message"
   ColumnDefinitions="*, Auto, 10, 35"
   RowDefinitions="Auto"
 
    SizeChanged="ParentGrid_SizeChanged">

    <Border
        x:Name="borderImage"
        Grid.Column="3" Grid.Row="0"

        HeightRequest="34"

        StrokeShape="RoundRectangle 5,5,5,0"
        StrokeThickness="1"
        VerticalOptions="End"
        WidthRequest="34">

        <Image Source="svg_user.png" />
    </Border>

    <Border
        x:Name="borderText"
        Grid.Column="1" Grid.Row="0"
        Padding="12"

        StrokeShape="{OnPlatform WinUI='RoundRectangle 4,4,4,0',
                                 MacCatalyst='RoundRectangle 4,4,4,0',
                                 Default='RoundRectangle 16,16,16,0'}"

        StrokeThickness="1">

        <Label
            Style="{StaticResource TxtSubtitle2_2}"
            Text="{Binding Text}" />
    </Border>

</Grid>
