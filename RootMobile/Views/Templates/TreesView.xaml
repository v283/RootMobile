<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RootMobile.ViewModels"
             xmlns:models="clr-namespace:RootMobile.Models"
             xmlns:ffimageloading="clr-namespace:FFImageLoading.Maui;assembly=FFImageLoading.Maui"
             xmlns:services="clr-namespace:RootMobile.Services"
             x:Class="RootMobile.Views.Templates.TreesView"
             x:DataType="vm:TreesViewModel"
             BackgroundColor="White">
    <ContentView.Resources>
        <ResourceDictionary>
            <services:InverseBooleanConverter x:Key="InvertedBoolConverter" />
        </ResourceDictionary>
    </ContentView.Resources>
    
    <Grid>
        <CollectionView x:Name="treesCollection"
                        Scrolled="OnCollectionViewScrolled"
                        ItemsSource="{Binding UsersTrees}"
                        RemainingItemsThreshold="5"
                        RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}">
                
            <CollectionView.Footer>
                <BoxView HeightRequest="130" BackgroundColor="White" />
            </CollectionView.Footer>

            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="0" />
            </CollectionView.ItemsLayout>

            <CollectionView.EmptyView>
                    <Grid IsVisible="{Binding IsEmpty}" HorizontalOptions="Center" VerticalOptions="Center">
                        <Label Text="Ви ще не висадили жодного дерева" TextColor="Gray" FontSize="16" HorizontalOptions="Center" />
                    </Grid>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                     <DataTemplate x:DataType="models:PlantPinDataModel">
                    <VerticalStackLayout>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Padding="16,12,16,8">

                            <VerticalStackLayout Grid.Column="1" Spacing="4">

                                <HorizontalStackLayout Spacing="6">
                                    <Label Text="{Binding Name}"
                                           FontAttributes="Bold"
                                           FontSize="15"
                                           TextColor="Black" />
                                </HorizontalStackLayout>

                                <Border StrokeShape="RoundRectangle 16"
                                        StrokeThickness="1"
                                        Stroke="#EFF3F4"
                                        BackgroundColor="#F5F8FA"
                                        Margin="0,0,0,8">
                                    <ffimageloading:CachedImage Source="{Binding Image}"
                                                                Aspect="AspectFill"
                                                                HeightRequest="220"
                                                                ErrorPlaceholder="camera.png"
                                                                LoadingPlaceholder="camera.png"
                                                                FadeAnimationEnabled="True" />
                                </Border>

                                <Label Text="{Binding Description}"
                                       FontSize="15"
                                       TextColor="#0F1419"
                                       LineBreakMode="WordWrap"
                                       Margin="0,0,0,0">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsExpanded}" Value="False">
                                            <Setter Property="MaxLines" Value="2" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsExpanded}" Value="True">
                                            <Setter Property="MaxLines" Value="100" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>

                                <Label TextColor="#536471"
                                       FontSize="14"
                                       Margin="0,-2,0,6">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TreesViewModel}}, Path=ToggleExpandCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Label.GestureRecognizers>

                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsExpanded}" Value="False">
                                            <Setter Property="Text" Value="ще..." />
                                            <Setter Property="IsVisible" Value="True" />
                                        </DataTrigger>

                                        <DataTrigger TargetType="Label" Binding="{Binding IsExpanded}" Value="True">
                                            <Setter Property="Text" Value="згорнути" />
                                            <Setter Property="IsVisible" Value="True" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>

                                <HorizontalStackLayout Spacing="0" Margin="0,4,0,4">
                                    <HorizontalStackLayout.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding OpenCommentsAsync}" CommandParameter="{Binding .}" />
                                    </HorizontalStackLayout.GestureRecognizers>

                                    <Image Source="comments.png"
                                           WidthRequest="18"
                                           HeightRequest="18"
                                           VerticalOptions="Center"
                                           Margin="0,0,6,0" />
                                    <Label Text="Коментувати"
                                           TextColor="#536471"
                                           FontSize="13"
                                           VerticalOptions="Center" />
                                </HorizontalStackLayout>

                            </VerticalStackLayout>
                        </Grid>

                        <BoxView HeightRequest="1"
                                 Color="#EFF3F4"
                                 HorizontalOptions="FillAndExpand" />
                    </VerticalStackLayout>
                </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" HorizontalOptions="Center" VerticalOptions="Center" Color="#2FBF71" />
    </Grid>
</ContentView>