<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RootMobile.ViewModels"
             xmlns:models="clr-namespace:RootMobile.Models"
             xmlns:ffimageloading="clr-namespace:FFImageLoading.Maui;assembly=FFImageLoading.Maui"
             x:Class="RootMobile.Views.Templates.TreesView"
             x:DataType="vm:TreesViewModel"
             BackgroundColor="White">

    <Grid>
        <CollectionView x:Name="treesCollection"
                        Scrolled="OnCollectionViewScrolled"
                        ItemsSource="{Binding UsersTrees}"
                        RemainingItemsThreshold="5"
                        RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}">
                
            <CollectionView.Footer>
                <BoxView HeightRequest="130" BackgroundColor="White" />
            </CollectionView.Footer>

            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="0" />
            </CollectionView.ItemsLayout>

            <CollectionView.EmptyView>
                    <Grid IsVisible="{Binding IsEmpty}" HorizontalOptions="Center" VerticalOptions="Center">
                        <Label Text="Ви ще не висадили жодного дерева" TextColor="Gray" FontSize="16" HorizontalOptions="Center" />
                    </Grid>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:PlantPinDataModel">
                        <VerticalStackLayout>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Padding="16,12,16,8">
                                
                                <!-- <Border Grid.Column="0" WidthRequest="40" HeightRequest="40" StrokeShape="RoundRectangle 20" StrokeThickness="0" VerticalOptions="Start"> -->
                                <!--     <Image Source="camera.png" Aspect="AspectFill" /> -->
                                <!-- </Border> -->

                                <VerticalStackLayout Grid.Column="1" Spacing="4">
                                    
                                    <HorizontalStackLayout Spacing="6">
                                        <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="15" TextColor="Black" />
                                    </HorizontalStackLayout>



                                    <Border StrokeShape="RoundRectangle 16" StrokeThickness="1" Stroke="#EFF3F4" BackgroundColor="#F5F8FA" Margin="0,0,0,8">
                                        <ffimageloading:CachedImage Source="{Binding Image}" 
                                                                    Aspect="AspectFill" 
                                                                    HeightRequest="220" 
                                                                    ErrorPlaceholder="camera.png" 
                                                                    LoadingPlaceholder="camera.png" 
                                                                    FadeAnimationEnabled="True" />
                                    </Border>
                                    
                                    <Label Text="{Binding Description}" FontSize="15" TextColor="#0F1419" LineBreakMode="WordWrap" Margin="0,0,0,6" />
                                    
                                    <HorizontalStackLayout Spacing="0" Margin="0,4,0,4">
                                        <HorizontalStackLayout.GestureRecognizers>
                                            <TapGestureRecognizer />
                                        </HorizontalStackLayout.GestureRecognizers>
                                        
                                        <Image Source="comments.png" WidthRequest="18" HeightRequest="18" VerticalOptions="Center" Margin="0,0,6,0" />
                                        <Label Text="Коментувати" TextColor="#536471" FontSize="13" VerticalOptions="Center" />
                                    </HorizontalStackLayout>

                                </VerticalStackLayout>
                            </Grid>

                            <BoxView HeightRequest="1" Color="#EFF3F4" HorizontalOptions="FillAndExpand" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" HorizontalOptions="Center" VerticalOptions="Center" Color="#2FBF71" />
    </Grid>
</ContentView>