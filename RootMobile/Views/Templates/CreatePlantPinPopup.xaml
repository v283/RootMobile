<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               x:Class="RootMobile.Views.Templates.CreatePlantPinPopup"
               Color="Transparent">

    <Grid BackgroundColor="Transparent" Padding="20">
        <!-- Індикатор завантаження -->
        <ActivityIndicator x:Name="LoadingIndicator"
                           IsRunning="False"
                           IsVisible="False"
                           VerticalOptions="Center"
                           HorizontalOptions="Center"
                           Color="#27B96E"
                           ZIndex="10" 
                           HeightRequest="50"
                           WidthRequest="50"/>

        <Border x:Name="PopupBorder" 
                BackgroundColor="White" 
                StrokeShape="RoundRectangle 25"
                VerticalOptions="End" 
                HorizontalOptions="Center" 
                HeightRequest="650"
                WidthRequest="360"
                Padding="20">

            <Grid RowDefinitions="Auto, *, Auto">
                <!-- Заголовок -->
                <Label Grid.Row="0" Text="New Plant" TextColor="Black" FontSize="20" 
                       FontAttributes="Bold" HorizontalOptions="Center" Margin="0,0,0,20"/>

                <ScrollView Grid.Row="1">
                    <VerticalStackLayout Spacing="15">

                        <!-- Секція Фото -->
                        <VerticalStackLayout HorizontalOptions="Center" Spacing="5">
                            <Border StrokeShape="RoundRectangle 20" HeightRequest="200" WidthRequest="160" 
                                    StrokeThickness="0" BackgroundColor="#F0F0F0">
                                <Grid>
                                    <Image x:Name="PreviewImage" Aspect="AspectFill" />
                                    <Image x:Name="CameraPlaceholder" Source="camera_icon.png" 
                                           HeightRequest="40" Opacity="0.5" IsVisible="True"/>
                                </Grid>
                            </Border>
                            <Button Text="Change Photo" Clicked="OnTakePhotoClicked" 
                                    BackgroundColor="Transparent" TextColor="#27B96E" 
                                    FontSize="14" FontAttributes="Bold" />

                            <HorizontalStackLayout Spacing="10" HorizontalOptions="Center" Margin="0,5">
                                <Label Text="Використовувати ШІ аналіз" VerticalOptions="Center" FontSize="13" TextColor="Gray"/>
                                <Switch x:Name="AiEnabledSwitch" IsToggled="True" OnColor="#27B96E" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>

                        <!-- Поле Name -->
                        <Border StrokeShape="RoundRectangle 15" Stroke="#E8E8E8" Padding="15,8" BackgroundColor="White">
                            <VerticalStackLayout>
                                <Label Text="Plant Name" FontSize="12" TextColor="Gray" Margin="0,0,0,-5" />
                                <Entry x:Name="PlantNameEntry" Placeholder="Enter name" TextColor="Black" 
                                       FontSize="16" BackgroundColor="Transparent" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Поле Category -->
                        <Border StrokeShape="RoundRectangle 15" Stroke="#E8E8E8" Padding="15,8" BackgroundColor="White">
                            <VerticalStackLayout>
                                <Label Text="Category" FontSize="12" TextColor="Gray" Margin="0,0,0,-5" />
                                <Picker x:Name="CategoryPicker" Title="Select category" TextColor="Black" 
                                        FontSize="16" TitleColor="LightGray" BackgroundColor="Transparent"
                                        ItemDisplayBinding="{Binding Name}"/>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Поле Comment з кнопкою ШІ -->
                        <Border StrokeShape="RoundRectangle 15" Stroke="#E8E8E8" Padding="15,8" BackgroundColor="White">
                            <VerticalStackLayout Spacing="5">
                                <Grid ColumnDefinitions="*, Auto">
                                    <Label Grid.Column="0" Text="Comment" FontSize="12" TextColor="Gray" VerticalOptions="Center" />
                                    <Button Grid.Column="1" Text="✨ AI Допомога" Clicked="OnAiHelpClicked"
                                            BackgroundColor="Transparent" TextColor="#27B96E" 
                                            FontSize="10" HeightRequest="30" Padding="5,0"/>
                                </Grid>
                                <Editor x:Name="CommentEntry" Placeholder="Add a description..." TextColor="Black" 
                                        FontSize="15" AutoSize="TextChanges" MinimumHeightRequest="80" 
                                        BackgroundColor="Transparent" />
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </ScrollView>

                <!-- Кнопки внизу -->
                <VerticalStackLayout Grid.Row="2" Spacing="10" Margin="0,15,0,0">
                    <Button Text="Save Plant" Clicked="OnFinishPinClicked" 
                            BackgroundColor="#27B96E" TextColor="White" 
                            HeightRequest="55" CornerRadius="28" FontAttributes="Bold" FontSize="16" />

                    <Button Text="Cancel" Clicked="OnCancelClicked" 
                            BackgroundColor="Transparent" TextColor="Red" FontSize="14" />
                </VerticalStackLayout>
            </Grid>
        </Border>
    </Grid>
</toolkit:Popup>