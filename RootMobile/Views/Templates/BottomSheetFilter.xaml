<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Class="RootMobile.Views.Templates.BottomSheetFilter" Size="700,280"
    Color="Transparent" VerticalOptions="End"  >

    <Grid>
        <Border  x:Name="BottomSheetBorder" StrokeShape="RoundRectangle 20,20,0,0" >
            <VerticalStackLayout  x:Name="stackBtn" Padding="20">
                <Label FontSize="18" Text="Сортування" FontAttributes="Bold"/>
                <RadioButton Content="Популярні" Value="0" />
                <RadioButton Content="Дешеві" Value="1" />
                <RadioButton Content="Дорогі" Value="2" />
                <RadioButton Content="Від А до Я" Value="3" />
                <RadioButton Content="Від Я до А" Value="4" />

            </VerticalStackLayout>
        </Border>
    </Grid>
</toolkit:Popup>
