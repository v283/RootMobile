<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               x:Class="RootMobile.Views.Templates.FilterPopup"
               Color="Transparent">

    <Border BackgroundColor="White" StrokeShape="RoundRectangle 20"
            Padding="20" WidthRequest="320" VerticalOptions="Center">
        <VerticalStackLayout Spacing="15">
            <Label Text="Filter by Category" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center" />

            <CollectionView x:Name="CategoriesList" SelectionMode="Single" SelectionChanged="OnSelectionChanged">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="10">
                            <Label Text="{Binding Name}" FontSize="16" TextColor="Black" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Button Text="Clear Filter" Clicked="OnClearClicked" BackgroundColor="Gray" TextColor="White" CornerRadius="10" />
            <Button Text="Close" Clicked="OnCloseClicked" BackgroundColor="Transparent" TextColor="#27B96E" />
        </VerticalStackLayout>
    </Border>
</toolkit:Popup>