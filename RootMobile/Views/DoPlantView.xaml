<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RootMobile.Views.DoPlantView"
             Title="Plan to Plant"
             BackgroundColor="White">

    <VerticalStackLayout Padding="30" Spacing="25" VerticalOptions="Center">

        <Image Source="seedling.png" HeightRequest="100" HorizontalOptions="Center" />

        <Label Text="Яку рослину ви хочете тут посадити?" 
               FontSize="22" FontAttributes="Bold" 
               HorizontalTextAlignment="Center" TextColor="Black" />

        <Border Stroke="#E8E8E8" StrokeThickness="1" StrokeShape="RoundRectangle 15" Padding="15,5">
            <Entry x:Name="PlantEntry" 
                   Placeholder="Наприклад: Яблуня, Лаванда..." 
                   TextColor="Black" FontSize="18" 
                   HorizontalTextAlignment="Center"/>
        </Border>

        <Button Text="Отримати консультацію ШІ" 
                Clicked="OnConsultAiClicked"
                HeightRequest="60" CornerRadius="30"
                BackgroundColor="#27B96E" TextColor="White" 
                FontAttributes="Bold" FontSize="16" />

        <Label Text="ШІ проаналізує ваші координати та кліматичні умови цієї зони" 
               FontSize="12" TextColor="Gray" HorizontalTextAlignment="Center" />

    </VerticalStackLayout>
</ContentPage>