<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="RootMobile.Views.EditAccountView"
             Shell.NavBarIsVisible="False"
             BackgroundColor="White">

    <Grid  RowDefinitions="Auto,*">
        
        <!-- Header -->
        <Grid Grid.Row="0"
              ColumnDefinitions="Auto,*,Auto"
              Padding="16,6,16,10">

            <Image Source="back.png"
                   HeightRequest="24"
                   WidthRequest="24"
                   VerticalOptions="Center">
                <Image.GestureRecognizers>
                    <TapGestureRecognizer Tapped="BackTapped"/>
                </Image.GestureRecognizers>
            </Image>

            <Label Grid.Column="1"
                   Text="Edit Profile"
                   FontSize="20"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   VerticalOptions="Center" />

            <Label Grid.Column="2"
                   Text="Save"
                   FontSize="16"
                   FontAttributes="Bold"
                   TextColor="#2FBF71"
                   VerticalOptions="Center"
                   HorizontalOptions="End">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="SaveTapped"/>
                </Label.GestureRecognizers>
            </Label>
        </Grid>

        <ScrollView Padding="16,8,16,0" Grid.Row="1">
            <VerticalStackLayout Spacing="20" Padding="0,10,0,30">

                <!-- Avatar -->
                <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                    <Grid WidthRequest="158" HeightRequest="158">
                        <Border WidthRequest="158"
                                HeightRequest="158"
                                Stroke="#c7c9c7"
                                StrokeThickness="0.2"
                                StrokeShape="RoundRectangle 90">
                            <Image x:Name="ProfileImage" Source="{Binding UserData.Image}" 
                                   Aspect="AspectFill" />
                        </Border>

                        <!-- Dark overlay -->
                        <BoxView BackgroundColor="#80000000"
                                 CornerRadius="90"/>

                        <!-- Camera -->
                        <Image Source="camera.png"
                               WidthRequest="60"
                               HeightRequest="60"
                               HorizontalOptions="Center"
                               VerticalOptions="Center">
                            <Image.Behaviors>
                                <toolkit:IconTintColorBehavior TintColor="Gray"/>
                            </Image.Behaviors>
                        </Image>
                        <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="ChangePhotoTapped"/>
                        </Grid.GestureRecognizers>

                    </Grid>

                    <Label Text="Change Photo"
                           FontSize="14"
                           TextColor="#2FBF71"
                           HorizontalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="ChangePhotoTapped"/>
                        </Label.GestureRecognizers>
                    </Label>
                </VerticalStackLayout>

                <!-- Name -->
                <Border Padding="14"
                        BackgroundColor="White"
                        Stroke="#E8E8E8"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 18">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Name"
                               FontSize="13"
                               TextColor="#6E6E6E"/>
                        <Entry x:Name="NameEntry"
                               Text="{Binding UserData.Name}"
                               FontSize="16"
                               TextColor="Black"
                               BackgroundColor="Transparent"
                               Placeholder="Enter your name"
                               ClearButtonVisibility="WhileEditing"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Phone -->
                <Border Padding="14"
                        BackgroundColor="White"
                        Stroke="#E8E8E8"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 18">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Phone Number"
                               FontSize="13"
                               TextColor="#6E6E6E"/>
                        <Entry x:Name="PhoneEntry"
                               Text="{Binding UserData.Phone}"
                               Keyboard="Telephone"
                               FontSize="16"
                               TextColor="Black"
                               BackgroundColor="Transparent"
                               Placeholder="Enter phone number"
                               ClearButtonVisibility="WhileEditing"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Status -->
                <Border Padding="14"
                        BackgroundColor="White"
                        Stroke="#E8E8E8"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 18">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Status"
                               FontSize="13"
                               TextColor="#6E6E6E"/>
                        <Entry x:Name="StatusEntry"
                               Text="{Binding UserData.Status}"
                               FontSize="16"
                               TextColor="Black"
                               BackgroundColor="Transparent"
                               Placeholder="Enter your status"
                               ClearButtonVisibility="WhileEditing"/>
                        <Label Text="Your status will be visible to other users"
                               FontSize="11"
                               TextColor="#9A9A9A"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Button -->
                <Button Text="Save Changes"
                        Clicked="SaveTapped"
                        HeightRequest="56"
                        CornerRadius="22"
                        BackgroundColor="#2FBF71"
                        TextColor="White"
                        FontAttributes="Bold"
                        Margin="0,10,0,0"/>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>