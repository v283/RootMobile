<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RootMobile.ViewModels"
             xmlns:models="clr-namespace:RootMobile.Models"
             xmlns:ffimageloading="clr-namespace:FFImageLoading.Maui;assembly=FFImageLoading.Maui"
             x:Class="RootMobile.Views.CommunityPostsView"
             x:DataType="vm:CommunityPostsViewModel"
             x:Name="RootPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="White">

    <Grid RowDefinitions="Auto,Auto,*">

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Padding="12,8,12,6">
            <Border Grid.Column="0"
                    Stroke="Transparent"
                    BackgroundColor="#F5F5F5"
                    StrokeThickness="0"
                    Padding="-7"
                    StrokeShape="RoundRectangle 24">
                <SearchBar Placeholder="Пошук постів..."
                           TextChanged="SearchBar_TextChanged" />
            </Border>

            <ActivityIndicator Grid.Column="1"
                               Margin="10,0,0,0"
                               IsRunning="{Binding IsLoading}"
                               IsVisible="{Binding IsLoading}"
                               VerticalOptions="Center" />
        </Grid>

        <CollectionView Grid.Row="1"
                        Margin="0,0,0,8"
                        HeightRequest="45"
                        ItemsSource="{Binding RadiusOptions}"
                        SelectionMode="None">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:RadiusOptionModel">
                    <Border Padding="14,8"
                            Margin="12,0,0,0"
                            StrokeThickness="1"
                            BackgroundColor="{Binding IsSelected, Converter={StaticResource BoolToColorConverterCategoriesView}}"
                            Stroke="{Binding IsSelected, Converter={StaticResource BoolToColorConverterCategoriesView}}"
                            StrokeShape="RoundRectangle 22">
                        <Label Text="{Binding Title}"
                               TextColor="White" />
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding BindingContext.SelectRadiusCommand, Source={x:Reference RootPage}}"
                                CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding Posts}"
                        RemainingItemsThreshold="5"
                        RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}">
            <CollectionView.Footer>
                <BoxView HeightRequest="120" BackgroundColor="Transparent" />
            </CollectionView.Footer>

            <CollectionView.EmptyView>
                <Grid IsVisible="{Binding IsEmpty}">
                    <Label Text="Пости не знайдено"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           TextColor="Gray" />
                </Grid>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:PlantPinDataModel">
                    <VerticalStackLayout Spacing="0">
                        <Grid ColumnDefinitions="Auto,*"
                              ColumnSpacing="12"
                              Padding="16,12,16,8">

                            <Border Grid.Column="0"
                                    WidthRequest="42"
                                    HeightRequest="42"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 21">
                                <Image Source="{Binding UserImage}" Aspect="AspectFill" />
                            </Border>

                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <HorizontalStackLayout Spacing="8">
                                    <Label Text="{Binding UserName}"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           TextColor="Black" />

                                    <Label Text="{Binding DistanceText}"
                                           FontSize="12"
                                           TextColor="#6B7280"
                                           IsVisible="{Binding DistanceKm}" />
                                </HorizontalStackLayout>

                                <Label Text="{Binding Name}"
                                       FontSize="14"
                                       TextColor="#111827" />

                                <Border StrokeShape="RoundRectangle 16"
                                        StrokeThickness="1"
                                        Stroke="#EFF3F4"
                                        BackgroundColor="#F5F8FA"
                                        Margin="0,0,0,8">
                                    <ffimageloading:CachedImage Source="{Binding Image}"
                                                                Aspect="AspectFill"
                                                                HeightRequest="220"
                                                                ErrorPlaceholder="camera.png"
                                                                LoadingPlaceholder="camera.png" />
                                </Border>

                                <Label Text="{Binding Description}"
                                       FontSize="15"
                                       TextColor="#0F1419"
                                       LineBreakMode="WordWrap">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsExpanded}" Value="False">
                                            <Setter Property="MaxLines" Value="2" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsExpanded}" Value="True">
                                            <Setter Property="MaxLines" Value="100" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>

                                <Label TextColor="#536471"
                                       FontSize="14"
                                       Margin="0,-2,0,6">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding BindingContext.ToggleExpandCommand, Source={x:Reference RootPage}}"
                                            CommandParameter="{Binding .}" />
                                    </Label.GestureRecognizers>

                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsExpanded}" Value="False">
                                            <Setter Property="Text" Value="ще..." />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsExpanded}" Value="True">
                                            <Setter Property="Text" Value="згорнути" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>

                                <HorizontalStackLayout Spacing="6">
                                    <Image Source="comments.png"
                                           WidthRequest="18"
                                           HeightRequest="18">
                                        <Image.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding BindingContext.OpenCommentsCommand, Source={x:Reference RootPage}}"
                                                CommandParameter="{Binding .}" />
                                        </Image.GestureRecognizers>
                                    </Image>

                                    <Label Text="Коментувати"
                                           FontSize="13"
                                           TextColor="#536471">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding BindingContext.OpenCommentsCommand, Source={x:Reference RootPage}}"
                                                CommandParameter="{Binding .}" />
                                        </Label.GestureRecognizers>
                                    </Label>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Grid>

                        <BoxView HeightRequest="1" Color="#F1F1F1" />
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>