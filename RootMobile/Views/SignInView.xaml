<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RootMobile.Views.SignInView"
             Shell.NavBarIsVisible="False"
             BackgroundColor="White">

    <Grid Padding="24,40,24,24"
          RowDefinitions="*,Auto"
          RowSpacing="24">

        <VerticalStackLayout Grid.Row="0"
                             Spacing="20"
                             VerticalOptions="Center">

            <VerticalStackLayout Spacing="4"
                                 HorizontalOptions="Center">
                <Label Text="Hello."
                       FontSize="28"
                       FontAttributes="Bold"
                       TextColor="#111827"
                       HorizontalTextAlignment="Center" />
                <Label Text="Welcome back"
                       FontSize="14"
                       TextColor="#9CA3AF"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="16">

                <!-- Email -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="Email"
                           FontSize="12"
                           TextColor="#374151" />
                    <Border BackgroundColor="#F3F4F6"
                            Stroke="#F3F4F6"
                            StrokeShape="RoundRectangle 8"
                            Padding="12,4">
                        <Grid ColumnDefinitions="20,*"
                              ColumnSpacing="8"
                              VerticalOptions="Center">
                            <Image Source="email_icon.png"
                                   WidthRequest="18"
                                   HeightRequest="18"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                            <Entry x:Name="EmailEntry"
                                   Grid.Column="1"
                                   Placeholder="Enter email"
                                   Keyboard="Email"
                                   ReturnType="Next" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <!-- Password -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="Password"
                           FontSize="12"
                           TextColor="#374151" />
                    <Border BackgroundColor="#F3F4F6"
                            Stroke="#F3F4F6"
                            StrokeShape="RoundRectangle 8"
                            Padding="12,4">
                        <Grid ColumnDefinitions="20,*,20"
                              ColumnSpacing="8"
                              VerticalOptions="Center">
                            <Image Source="lock_icon.png"
                                   WidthRequest="18"
                                   HeightRequest="18"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                            <Entry x:Name="PasswordEntry"
                                   Grid.Column="1"
                                   Placeholder="Enter password"
                                   IsPassword="True"
                                   ReturnType="Go"
                                   Completed="PasswordEntry_Completed" />
                            <ImageButton x:Name="TogglePasswordBtn"
                                         Grid.Column="2"
                                         Source="eye_icon.png"
                                         BackgroundColor="Transparent"
                                         WidthRequest="18"
                                         HeightRequest="18"
                                         Clicked="TogglePasswordBtn_Clicked" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <Label Text="Forgot password?"
                       FontSize="12"
                       TextColor="#6DBA3F"
                       HorizontalOptions="End">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="ForgotPassword_Tapped" />
                    </Label.GestureRecognizers>
                </Label>
            </VerticalStackLayout>

            <Button x:Name="SignInButton"
                    Text="Sign In"
                    BackgroundColor="#6DBA3F"
                    TextColor="White"
                    CornerRadius="8"
                    HeightRequest="48"
                    Clicked="SignInButton_Clicked" />

            <ActivityIndicator x:Name="LoadingIndicator"
                               IsRunning="False"
                               IsVisible="False"
                               HeightRequest="30" />

            <Label Text="OR CONTINUE WITH"
                   FontSize="10"
                   TextColor="#9CA3AF"
                   HorizontalOptions="Center" />

            <HorizontalStackLayout Spacing="24"
                                   HorizontalOptions="Center">
                <Image Source="google_logo.webp"
                       WidthRequest="24"
                       HeightRequest="24">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Tapped="Google_Tapped"/>
                    </Image.GestureRecognizers>
                </Image>

                <Image Source="facebook_logo.png"
                       WidthRequest="24"
                       HeightRequest="24" />

                <Image Source="apple_logo.png"
                       WidthRequest="24"
                       HeightRequest="24" />
            </HorizontalStackLayout>
        </VerticalStackLayout>

        <HorizontalStackLayout Grid.Row="1"
                               Spacing="4"
                               HorizontalOptions="Center">
            <Label Text="Don't have an account?"
                   FontSize="12"
                   TextColor="#374151" />
            <Label Text="Sign up"
                   FontSize="12"
                   FontAttributes="Bold"
                   TextColor="#6DBA3F">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="GoToSignUp_Tapped"/>
                </Label.GestureRecognizers>
            </Label>
        </HorizontalStackLayout>
    </Grid>
</ContentPage>