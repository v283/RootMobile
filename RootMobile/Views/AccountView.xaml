                <!--         <Grid ColumnDefinitions="*,Auto"> -->
                <!--             <Label Text="850 / 1000 Trees" FontSize="12" TextColor="#6E6E6E" Grid.Column="0" /> -->
                <!--             <Label Text="85%" FontSize="12" TextColor="#6E6E6E" Grid.Column="1" HorizontalOptions="End" /> -->
