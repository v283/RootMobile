                <!--                 <Label Text="Forest Guardians" FontAttributes="Bold" FontSize="14" /> -->
                <!--                 <Label Text="Collaborating with 12 friends to plant a 1,000 tree grove in Northern Cali." FontSize="12" TextColor="#6E6E6E" /> -->
                <!--             </VerticalStackLayout> -->
                <!-- -->
