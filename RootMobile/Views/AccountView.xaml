                <!-- -->
                <!--         <Button Text="Contribute Now" BackgroundColor="#2FBF71" TextColor="White" CornerRadius="18" /> -->
                <!--     </VerticalStackLayout> -->
                <!-- </Border> -->
                
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Eco-Badges" FontSize="16" FontAttributes="Bold" Grid.Column="0" />
                    <Label Text="12 / 24 unlocked" FontSize="12" TextColor="#6E6E6E" Grid.Column="1" VerticalOptions="Center" />
                </Grid>

                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="12">
                    <VerticalStackLayout Grid.Column="0" Spacing="6" HorizontalOptions="Center">
                        <Border WidthRequest="48" HeightRequest="48" BackgroundColor="#E9F8F1" StrokeShape="RoundRectangle 12">
                            <Label Text="EB" TextColor="#2FBF71" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Text="Early Bird" FontSize="11" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="6" HorizontalOptions="Center">
                        <Border WidthRequest="48" HeightRequest="48" BackgroundColor="#E9F8F1" StrokeShape="RoundRectangle 12">
                            <Label Text="CO2" TextColor="#2FBF71" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Text="CO2 Warrior" FontSize="11" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="2" Spacing="6" HorizontalOptions="Center">
                        <Border WidthRequest="48" HeightRequest="48" BackgroundColor="#E9F8F1" StrokeShape="RoundRectangle 12">
                            <Label Text="TP" TextColor="#2FBF71" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Text="Top Planter" FontSize="11" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="3" Spacing="6" HorizontalOptions="Center">
                        <Border WidthRequest="48" HeightRequest="48" BackgroundColor="#E9F8F1" StrokeShape="RoundRectangle 12">
                            <Label Text="GD" TextColor="#2FBF71" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Text="Guardian" FontSize="11" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Grid>
                <Label Text="Project Center" HorizontalOptions="Center" FontSize="16" FontAttributes="Bold"  />
                <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="10">
                    <VerticalStackLayout Grid.Column="0" Spacing="6" HorizontalOptions="Center">
                        <Image WidthRequest="30" HeightRequest="30" Source="customer_support.png"/>
                        <Label Text="Help Center" FontSize="11" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="6" HorizontalOptions="Center">
                        <Image WidthRequest="30" HeightRequest="30" Source="privacy_policy.png"/>
                        <Label Text="Privacy Policy" FontSize="11" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="2" Spacing="6" HorizontalOptions="Center">
                        <Image WidthRequest="30" HeightRequest="30" Source="flying_money.png"/>
                        <Label Text="Support Project" FontSize="11" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="3" Spacing="6" HorizontalOptions="Center">
                        <Image WidthRequest="30" HeightRequest="30" Source="suggestion.png"/>
                        <Label Text="Suggestions" FontSize="11" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Column="4" Spacing="6" HorizontalOptions="Center">
                        <Image WidthRequest="30" HeightRequest="30" Source="add_friends.png"/>
                        <Label Text="Invite Friends" FontSize="11" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Grid>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
