<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RootMobile.Views.AccountView"
             Shell.NavBarIsVisible="False"
             BackgroundColor="White">
    <Grid Padding="16" RowDefinitions="Auto,*" ColumnDefinitions="*">
        <Grid RowDefinitions="*" ColumnDefinitions="Auto,*,Auto" Grid.Row="0" Grid.Column="0" Padding="0,6,0,12">
            <BoxView WidthRequest="28" HeightRequest="28" Opacity="0" Grid.Column="0"/>
            <Label Text="My Profile" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center" Grid.Column="1"/>
            <Image HeightRequest="24" WidthRequest="24" Source="settings.png" Grid.Column="2"/>
        </Grid>

        <ScrollView Grid.Row="1" Grid.Column="0">
            <VerticalStackLayout Spacing="20">
                <Border StrokeThickness="0" Padding="16" StrokeShape="RoundRectangle 24">

                    <VerticalStackLayout Spacing="10">
                        <Grid HorizontalOptions="Center">
                            <Grid WidthRequest="96" HeightRequest="96">
                                <Border Stroke="#c7c9c7" StrokeThickness="0.2" StrokeShape="RoundRectangle 48">
                                    <Image Source="dotnet_bot.png" Aspect="AspectFill" />
                                </Border>
                                <BoxView WidthRequest="12" HeightRequest="12" BackgroundColor="#2FBF71" CornerRadius="6" HorizontalOptions="End" VerticalOptions="End" Margin="0,0,4,4" />
                            </Grid>
                        </Grid>
                        

                        <Label Text="Alex Rivers" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center" />
                        <Label Text="Eco-Warrior" FontSize="12" TextColor="#6E6E6E" HorizontalOptions="Center" />

                        <Grid ColumnDefinitions="*,*,*" Padding="0,8,0,0">
                            <VerticalStackLayout Grid.Column="0" Spacing="2" HorizontalOptions="Center">
                                <Label Text="48" FontSize="16" FontAttributes="Bold" HorizontalOptions="Center" />
                                <Label Text="TREES" FontSize="10" TextColor="#6E6E6E" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="Center">
                                <Label Text="1.2k" FontSize="16" FontAttributes="Bold" HorizontalOptions="Center" />
                                <Label Text="CO2 (KG)" FontSize="10" TextColor="#6E6E6E" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" Spacing="2" HorizontalOptions="Center">
                                <Label Text="03" FontSize="16" FontAttributes="Bold" HorizontalOptions="Center" />
                                <Label Text="TEAMS" FontSize="10" TextColor="#6E6E6E" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>
                
                <!-- <Label Text="Team Impact" FontSize="16" FontAttributes="Bold" /> -->
