<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="RootMobile.Views.AccountView"
             Shell.NavBarIsVisible="False"
             BackgroundColor="White">
    <Grid Padding="16" RowDefinitions="Auto,*" ColumnDefinitions="*">
        <Grid RowDefinitions="*" ColumnDefinitions="Auto,*,Auto" Grid.Row="0" Grid.Column="0" Padding="0,6,0,1">
            <Image HeightRequest="24" WidthRequest="24" Source="email.png" Grid.Column="0">
                <Image.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoToEmailsCommand}"/>
                </Image.GestureRecognizers>
            </Image>
            
            <HorizontalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="10">
                <Label Text="My Profile" FontSize="20" FontAttributes="Bold"  />
                <Image Source="edit" WidthRequest="20" HeightRequest="20"   >
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToEditAccountCommand}"/>
                    </Image.GestureRecognizers>           
                    <Image.Behaviors>
                        <toolkit:IconTintColorBehavior TintColor="#374151"/>
                    </Image.Behaviors>
                </Image>
            </HorizontalStackLayout>

            <Image HeightRequest="24" WidthRequest="24" Source="settings.png" Grid.Column="2">
                <Image.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoToSettingsCommand}"/>
                </Image.GestureRecognizers>
            </Image>
        </Grid>

        <ScrollView Grid.Row="1" Grid.Column="0">
            <VerticalStackLayout Spacing="20">
                <Border StrokeThickness="0" Padding="16,0" StrokeShape="RoundRectangle 24">

                    <VerticalStackLayout Spacing="10">
                        <Grid RowDefinitions="20, Auto, Auto, Auto" ColumnDefinitions="Auto, *" ColumnSpacing="15" RowSpacing="15" HorizontalOptions="FillAndExpand">
                            <Grid Grid.Row="0" Grid.Column="0" Grid.RowSpan="4" WidthRequest="108" HeightRequest="108">

                                <Border WidthRequest="96" HeightRequest="96" Stroke="#c7c9c7" StrokeThickness="0.2" StrokeShape="RoundRectangle 48">
                                    <Image Source="dotnet_bot.png" Aspect="AspectFill" />
                                </Border>
                                <BoxView WidthRequest="12" HeightRequest="12" BackgroundColor="#2FBF71" CornerRadius="6" HorizontalOptions="End" VerticalOptions="End" Margin="0,0,4,4" />
                            </Grid>
                            
                            <Label Padding="15,0,0,0" Grid.Row="1" Grid.Column="1" Text="{Binding UserData.Name}" FontSize="18" FontAttributes="Bold" HorizontalOptions="Start" VerticalOptions="End" />
                            <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="*,*,*">
                                <VerticalStackLayout Grid.Column="0" Spacing="2" HorizontalOptions="Center">
                                    <Label Text="{Binding UserData.TreesPlanted}" FontSize="16" FontAttributes="Bold" HorizontalOptions="Center" />
                                    <Label Text="Trees&#10;Planted" FontSize="10" TextColor="#6E6E6E" HorizontalTextAlignment="Center" HorizontalOptions="Center" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="Center">
                                    <Label Text="{Binding UserData.TreesFound}" FontSize="16" FontAttributes="Bold" HorizontalOptions="Center" />
                                    <Label Text="Trees&#10;Found" FontSize="10" TextColor="#6E6E6E" HorizontalTextAlignment="Center" HorizontalOptions="Center" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="2" Spacing="2" HorizontalOptions="Center">
                                    <Label Text="{Binding UserData.TopRating}" FontSize="16" FontAttributes="Bold" HorizontalOptions="Center" />
                                    <Label Text="Global&#10;Rank" FontSize="10" TextColor="#6E6E6E" HorizontalTextAlignment="Center" HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </Grid>
                            <Label Grid.Row="3" Grid.Column="0" Text="Eco-Warrior" FontSize="12" TextColor="#6E6E6E" HorizontalOptions="Center" VerticalOptions="Start" />
                            
                        </Grid>
                        




                    </VerticalStackLayout>
                </Border>
                
                <!-- <Label Text="Team Impact" FontSize="16" FontAttributes="Bold" /> -->
                <!-- -->
                <!-- <Border Padding="16" BackgroundColor="White" StrokeShape="RoundRectangle 18"> -->
                <!--     <VerticalStackLayout Spacing="10"> -->
                <!--         <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"> -->
                <!--             <VerticalStackLayout Spacing="4"> -->
                <!--                 <Label Text="Forest Guardians" FontAttributes="Bold" FontSize="14" /> -->
                <!--                 <Label Text="Collaborating with 12 friends to plant a 1,000 tree grove in Northern Cali." FontSize="12" TextColor="#6E6E6E" /> -->
                <!--             </VerticalStackLayout> -->
                <!-- -->
                <!--         </Grid> -->
                <!-- -->
                <!--         <Grid ColumnDefinitions="*,Auto"> -->
                <!--             <Label Text="850 / 1000 Trees" FontSize="12" TextColor="#6E6E6E" Grid.Column="0" /> -->
                <!--             <Label Text="85%" FontSize="12" TextColor="#6E6E6E" Grid.Column="1" HorizontalOptions="End" /> -->
                <!--         </Grid> -->
                <!--         <ProgressBar Progress="0.85" ProgressColor="#2FBF71" BackgroundColor="#E1E1E1" HeightRequest="6" /> -->
                <!-- -->
                <!--         <Button Text="Contribute Now" BackgroundColor="#2FBF71" TextColor="White" CornerRadius="18" /> -->
                <!--     </VerticalStackLayout> -->
                <!-- </Border> -->
                
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Eco-Badges" FontSize="16" FontAttributes="Bold" Grid.Column="0" />
                    <Label Text="12 / 24 unlocked" FontSize="12" TextColor="#6E6E6E" Grid.Column="1" VerticalOptions="Center" />
                </Grid>

                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="12">
                    <VerticalStackLayout Grid.Column="0" Spacing="6" HorizontalOptions="Center">
                        <Border WidthRequest="48" HeightRequest="48" BackgroundColor="#E9F8F1" StrokeShape="RoundRectangle 12">
                            <Label Text="EB" TextColor="#2FBF71" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Text="Early Bird" FontSize="11" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="6" HorizontalOptions="Center">
                        <Border WidthRequest="48" HeightRequest="48" BackgroundColor="#E9F8F1" StrokeShape="RoundRectangle 12">
                            <Label Text="CO2" TextColor="#2FBF71" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Text="CO2 Warrior" FontSize="11" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="2" Spacing="6" HorizontalOptions="Center">
                        <Border WidthRequest="48" HeightRequest="48" BackgroundColor="#E9F8F1" StrokeShape="RoundRectangle 12">
                            <Label Text="TP" TextColor="#2FBF71" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Text="Top Planter" FontSize="11" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="3" Spacing="6" HorizontalOptions="Center">
                        <Border WidthRequest="48" HeightRequest="48" BackgroundColor="#E9F8F1" StrokeShape="RoundRectangle 12">
                            <Label Text="GD" TextColor="#2FBF71" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Text="Guardian" FontSize="11" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Grid>
                <Label Text="Project Center" HorizontalOptions="Center" FontSize="16" FontAttributes="Bold"  />
                <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="10">
                    <VerticalStackLayout Grid.Column="0" Spacing="6" HorizontalOptions="Center">
                        <Image WidthRequest="30" HeightRequest="30" Source="customer_support.png"/>
                        <Label Text="Help Center" FontSize="11" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="6" HorizontalOptions="Center">
                        <Image WidthRequest="30" HeightRequest="30" Source="privacy_policy.png"/>
                        <Label Text="Privacy Policy" FontSize="11" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="2" Spacing="6" HorizontalOptions="Center">
                        <Image WidthRequest="30" HeightRequest="30" Source="flying_money.png"/>
                        <Label Text="Support Project" FontSize="11" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="3" Spacing="6" HorizontalOptions="Center">
                        <Image WidthRequest="30" HeightRequest="30" Source="suggestion.png"/>
                        <Label Text="Suggestions" FontSize="11" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Column="4" Spacing="6" HorizontalOptions="Center">
                        <Image WidthRequest="30" HeightRequest="30" Source="add_friends.png"/>
                        <Label Text="Invite Friends" FontSize="11" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Grid>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
