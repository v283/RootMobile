<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
              xmlns:maps="clr-namespace:Maui.GoogleMaps;assembly=Maui.GoogleMaps"
             x:Class="RootMobile.Views.RootMapView" 
             Shell.NavBarIsVisible="False">

    <Grid>
        <!--<maps:Map x:Name="mymap" VerticalOptions="FillAndExpand" PinClicked="OnPinClicked" />-->


        <!-- Розділяємо на Рядок для Навбару та Рядок для Карти -->
        <Grid RowDefinitions="Auto, *">

            <!-- TOP NAVBAR SECTION -->
            <Border Grid.Row="0" 
                BackgroundColor="White" 
                Padding="15, 10" 
                StrokeThickness="0"
                HeightRequest="60">
                <!-- Додаємо невелику тінь, щоб відділити навбар від карти -->
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,2" Opacity="0.1" Radius="5" />
                </Border.Shadow>

                <Grid ColumnDefinitions="Auto, *, Auto">
                    <!-- Кнопка Фільтра зліва -->
                    <Image Grid.Column="0" 
                       Source="filter.png" 
                       HeightRequest="25" 
                       VerticalOptions="Center">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnFilterClicked" />
                        </Image.GestureRecognizers>
                    </Image>

                </Grid>
            </Border>

            <!-- MAP SECTION -->
            <Grid Grid.Row="1">
                <maps:Map x:Name="mymap" VerticalOptions="FillAndExpand" PinClicked="OnPinClicked" />

                <!-- Кнопка "Створити" (плаває поверх карти знизу) -->
                <HorizontalStackLayout VerticalOptions="End" HorizontalOptions="Center" Margin="20" Spacing="10">
                    <!-- Нова кнопка "Посадити" -->
                    <Button x:Name="BtnDoPlant" Text="Plant Here" 
                Clicked="OnDoPlantClicked" 
                HeightRequest="60" CornerRadius="30" WidthRequest="110"
                BackgroundColor="#2FBF71" TextColor="White" FontAttributes="Bold" FontSize="16"></Button>

                    <!-- Кнопка "Create Pin" -->
                    <Button x:Name="BtnCreate" Text="Create Pin" 
                Clicked="OnCreatePinClicked" 
                HeightRequest="60" CornerRadius="30" WidthRequest="150"
                BackgroundColor="#27B96E" TextColor="White" FontAttributes="Bold" FontSize="16">
                    </Button>
                </HorizontalStackLayout>
            </Grid>

        </Grid>

    </Grid>

</ContentPage>